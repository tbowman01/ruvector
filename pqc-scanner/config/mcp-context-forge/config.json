{
  "$schema": "https://raw.githubusercontent.com/IBM/mcp-context-forge/main/config.schema.json",
  "version": "1.0",
  "servers": [
    {
      "name": "pqc-scanner",
      "displayName": "PQC Vulnerability Scanner",
      "description": "Scan code for quantum-vulnerable cryptographic algorithms",
      "url": "http://pqc-scanner:8001/mcp",
      "transport": "http",
      "capabilities": {
        "tools": true,
        "resources": true,
        "prompts": true
      },
      "healthCheck": {
        "enabled": true,
        "endpoint": "http://pqc-scanner:8001/health",
        "interval": 30000,
        "timeout": 5000
      },
      "retries": {
        "maxAttempts": 3,
        "backoffMs": 1000
      }
    },
    {
      "name": "docling",
      "displayName": "Docling Document Processor",
      "description": "Convert and process documents (PDF, DOCX, PPTX, images) to extract text and tables",
      "url": "http://docling:8002/mcp",
      "transport": "http",
      "capabilities": {
        "tools": true,
        "resources": true,
        "prompts": false
      },
      "healthCheck": {
        "enabled": true,
        "endpoint": "http://docling:8002/health",
        "interval": 30000,
        "timeout": 10000
      },
      "retries": {
        "maxAttempts": 3,
        "backoffMs": 2000
      }
    }
  ],
  "routing": {
    "defaultServer": "pqc-scanner",
    "toolRoutes": {
      "scan_code": "pqc-scanner",
      "get_recommendations": "pqc-scanner",
      "list_algorithms": "pqc-scanner",
      "check_compliance": "pqc-scanner",
      "scan_github_org": "pqc-scanner",
      "scan_github_repo": "pqc-scanner",
      "list_github_repos": "pqc-scanner",
      "scan_github_file": "pqc-scanner",
      "convert_document": "docling",
      "convert_document_from_url": "docling",
      "list_converted_documents": "docling",
      "get_document_content": "docling",
      "extract_tables": "docling",
      "extract_images": "docling",
      "batch_convert": "docling"
    }
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "cors": {
    "enabled": true,
    "origins": ["http://localhost:8081", "http://open-webui:8080"],
    "methods": ["GET", "POST", "OPTIONS"],
    "headers": ["Content-Type", "Authorization"]
  }
}
